# Primary (Lovable) Supabase project used by frontend and normal app traffic.
VITE_SUPABASE_URL=https://YOUR_LOVABLE_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_LOVABLE_ANON_OR_PUBLISHABLE_KEY

# Optional backup mirror target (your own Supabase).
# Configure these as Supabase Edge Function secrets in the PRIMARY project,
# not as frontend env vars.
# BACKUP_SUPABASE_URL=https://YOUR_BACKUP_PROJECT_REF.supabase.co
# BACKUP_SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKUP_SERVICE_ROLE_KEY
